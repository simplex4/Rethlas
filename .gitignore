__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv-chatgpt/
.venv/
venv/
env/

# Local editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local environment and credentials
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx

# ChatGPT MCP state, credentials, exports, and locks
.local/chatgpt-workflow/

